# Alibaba Cloud Model Studio / DashScope
# Copy this file to .env and put the real key only in .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen main model
QWEN_MODEL=qwen3.7-plus
QWEN_TEMPERATURE=0.2
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2
QWEN_MAX_OUTPUT_TOKENS=8192

# Retrieval embedding model
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Optional LangSmith tracing; keep disabled by default for document privacy
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=office-document-agent

# Application
APP_ENV=development
APP_DATA_DIR=/app/data
MAX_FILE_SIZE_MB=25
MAX_WORKSPACE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=20
MAX_MODEL_CALLS_PER_TASK=12
MAX_TASK_RUNTIME_SECONDS=300
